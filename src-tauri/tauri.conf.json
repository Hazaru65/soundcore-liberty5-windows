{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundcore Liberty 5",
  "version": "0.2.0",
  "identifier": "com.vibec.soundcore-liberty5",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soundcore Liberty 5",
        "width": 480,
        "height": 640,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
